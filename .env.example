# ==========================================
# Job Market Analytics Pipeline - Environment
# ==========================================
# Copy this file to .env and fill in your values.

# Flask API authentication key (must match between Airflow and Flask)
KNIME_API_KEY=your-secure-api-key-here

# Student details (used in pipeline metrics)
STUDENT_NAME=Your Name
STUDENT_EMAIL=your-email@example.com

# Airflow credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=your-strong-password-here

# PostgreSQL
POSTGRES_PASSWORD=your-db-password-here
